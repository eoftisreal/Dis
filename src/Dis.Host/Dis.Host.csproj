<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Dis</AssemblyName>
    <AssemblyName Condition="'$(DisHostAssemblyName)' != ''">$(DisHostAssemblyName)</AssemblyName>
    <Version>0.4.4</Version>
    <Title>Dis Virtual Monitor</Title>
    <Product>Dis Virtual Monitor</Product>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Dis.Core/Dis.Core.csproj" /></ItemGroup>
  <ItemGroup Condition="'$(DisUsbToolsArchive)' != ''">
    <EmbeddedResource Include="$(DisUsbToolsArchive)" LogicalName="Dis.UsbTools.zip" />
  </ItemGroup>
</Project>
