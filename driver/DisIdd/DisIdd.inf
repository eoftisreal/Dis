;
; DisIdd.inf
;

[Version]
PnpLockDown=1
Signature="$Windows NT$"
ClassGUID = {4D36E968-E325-11CE-BFC1-08002BE10318}
Class = Display
ClassVer = 2.0
Provider=%ManufacturerName%
CatalogFile=DisIdd.cat
DriverVer=10/27/2026,0.1.0.0

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$.10.0...22000

[Standard.NT$ARCH$.10.0...22000]
%DeviceName%=MyDevice_Install, Root\DisDisplay
%DeviceName%=MyDevice_Install, DisDisplay

[SourceDisksFiles]
DisIdd.dll=1

[SourceDisksNames]
1 = %DiskName%

; =================== UMDF Device ==================================

[MyDevice_Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=UMDriverCopy

[MyDevice_Install.NT.hw]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg = MyDevice_HardwareDeviceSettings

[MyDevice_HardwareDeviceSettings]
HKR,, "UpperFilters",  %REG_MULTI_SZ%, "IndirectKmd"
HKR, "WUDF", "DeviceGroupId", %REG_SZ%, "Dis-83B18D8C-1A4C-4E60-95B1-F066C151DDF7"

[MyDevice_Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[MyDevice_Install.NT.Wdf]
UmdfService=DisIdd,DisIdd_Install
UmdfServiceOrder=DisIdd
UmdfKernelModeClientPolicy = AllowKernelModeClients

[DisIdd_Install]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%12%\UMDF\DisIdd.dll
UmdfExtensions = IddCx0102

[DestinationDirs]
UMDriverCopy=12,UMDF ; copy to drivers\umdf

[UMDriverCopy]
DisIdd.dll

; =================== Generic ==================================

[Strings]
ManufacturerName="Dis Project"
DiskName = "DisIdd Installation Disk"
DeviceName="Dis Virtual Display"

REG_MULTI_SZ  = 0x00010000
REG_SZ        = 0x00000000

